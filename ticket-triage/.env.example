# Copy this file to ".env" (same folder) and paste your Gemini key after the = sign.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Optional settings (the defaults work; change only if you need to) ---
# Cheap, fast model used for every ticket:
FAST_MODEL=gemini-3.5-flash-lite
# Stronger model used when the fast one is unsure or fails:
STRONG_MODEL=gemini-3.8-flash
# Below this confidence a ticket goes to a human:
CONFIDENCE_THRESHOLD=0.75
# Tickets labelled Urgent need even higher confidence, or a human checks them:
URGENT_CONFIDENCE_THRESHOLD=0.90
# Parallel requests, and a cap on requests per minute.
# On a free key you may need REQUESTS_PER_MINUTE=10 (otherwise you will see slow retries).
MAX_WORKERS=4
REQUESTS_PER_MINUTE=30
